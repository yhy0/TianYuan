{
  "name": "tianyuan",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tianyuan --local",
    "db:migrate": "wrangler d1 migrations apply tianyuan --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
